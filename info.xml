<?xml version="1.0"?>
<extension key="com.joineryhq.mailtolink" type="module">
  <file>mailtolink</file>
  <name>MailtoLink</name>
  <description>Converts email addresses to clickable "mailto:" links, on search results and contact summary view.</description>
  <license>GPL-3.0</license>
  <maintainer>
    <author>Allen Shaw</author>
    <email>allen@JoineryHQ.com</email>
  </maintainer>
  <urls>
    <url desc="Main Extension Page">https://github.com/twomice/com.joineryhq.mailtolink</url>
    <url desc="Documentation">https://github.com/twomice/com.joineryhq.mailtolink</url>
    <url desc="Support">https://github.com/twomice/com.joineryhq.mailtolink/issues</url>
    <url desc="Licensing">http://www.gnu.org/licenses/gpl-3.0.html</url>
  </urls>
  <releaseDate>2026-08-26</releaseDate>
  <version>1.1.2</version>
  <develStage>beta</develStage>
  <compatibility>
    <ver>5.51</ver>
  </compatibility>
  <comments/>
  <civix>
    <namespace>CRM/Mailtolink</namespace>
    <format>25.10.2</format>
  </civix>
  <classloader>
    <psr4 prefix="Civi\" path="Civi"/>
  </classloader>
  <mixins>
    <mixin>scan-classes@1.0.0</mixin>
  </mixins>
</extension>
